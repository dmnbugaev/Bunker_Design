{
  "name": "bunker-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "NITRO_HOST=127.0.0.1 nuxt preview",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "stores:geocode": "node scripts/geocode-stores.mjs",
    "postinstall": "nuxt prepare && node scripts/prepare-public.mjs",
    "typecheck": "nuxt typecheck",
    "test": "playwright test",
    "test:unit": "node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check app server shared nuxt.config.ts playwright.config.ts tests scripts",
    "format": "prettier --write app server shared nuxt.config.ts playwright.config.ts tests scripts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "jiti": "^2.7.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22"
  }
}
