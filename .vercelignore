# Файлы, которые не загружаются на Vercel при каждом деплое.
# Всё перечисленное остаётся в репозитории (дизайн-кит, документация,
# тесты), но не участвует в сборке и не раздувает аплоад.
# Правила — как в .gitignore: «tests/*» + «!tests/fixtures» оставляют
# фикстуру каталога, чтобы preview-деплои могли работать в демо-режиме
# (MOYSKLAD_SNAPSHOT_PATH=./tests/fixtures/catalog.json).

# Дизайн-кит: демо дизайн-системы и библиотека референсов (24 МБ).
# Смотреть локально: npm run design-kit.
design-kit

# Документация и аудиты.
docs
README.md

# Тесты и артефакты (кроме фикстуры каталога — см. выше).
tests/*
!tests/fixtures
test-results
test-artifacts

# Операционные скрипты (выгрузка «МойСклад», геокодинг, генератор
# фикстуры, локальный сервер дизайн-кита) — сборке не нужны.
scripts

# CI и настройки редакторов/агентов.
.github
.idea
.agents
.zcode

# Конфиги тестирования и линтеров не участвуют в продакшен-сборке.
playwright.config.ts
playwright.audit.config.ts
eslint.config.mjs
.prettierrc.json
.prettierignore
