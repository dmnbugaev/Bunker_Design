# ─── «МойСклад» ────────────────────────────────────────────────────────────
# API-токен аккаунта «Бункера»: online.moysklad.ru → Профиль → API-токены.
# Секрет: только сервер (server/services/moysklad.ts), в браузер не попадает.
NUXT_MOYSKLAD_TOKEN=

# Фикстурный режим без живого «МойСклад» (разработка/e2e): каталог берётся из
# JSON-снимка, бонусные ответы — тестовые. В production НЕ задавать.
# Для запуска без токена: MOYSKLAD_SNAPSHOT_PATH=./tests/fixtures/catalog.json
MOYSKLAD_SNAPSHOT_PATH=./tests/fixtures/catalog.json

# Типы цен в порядке приоритета (через запятую, имена из аккаунта).
# Без значения используется первый ненулевой тип цены товара — для продающего
# сайта список рекомендуется задать явно, см. docs/INTEGRATION.md.
MOYSKLAD_PRICE_TYPES=

# Служебные склады, скрытые с сайта: имена и префиксы (через запятую).
# Префиксом удобно скрывать распределительные центры с суффиксами: РЦ
MOYSKLAD_INTERNAL_STORES=
MOYSKLAD_INTERNAL_STORE_PREFIXES=

# Доп. поля товара (необязательны; отсутствующее поле не влияет на выгрузку):
# булево «показывать на сайте» и текстовое «название для сайта».
MOYSKLAD_ATTR_PUBLISH=Показать на сайте
MOYSKLAD_ATTR_SITE_NAME=Название для сайта

# Выбор бонусной программы при нескольких активных в аккаунте: id или имя.
# Без значения берётся первая активная (entity/bonusprogram).
MOYSKLAD_BONUS_PROGRAM_ID=
MOYSKLAD_BONUS_PROGRAM_NAME=

# Исполнитель задач-уведомлений в «МойСклад» (id сотрудника); без значения —
# владелец API-токена.
MOYSKLAD_NOTIFY_EMPLOYEE_ID=

# ─── Сайт (публичные) ──────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=https://bunker.example
# Яндекс.Метрика: auto | 0 | 1 и номер счётчика (пусто — счётчик не грузится).
NUXT_PUBLIC_METRIKA_ENABLED=auto
NUXT_PUBLIC_METRIKA_COUNTER_ID=
# Публичный ключ JS API Яндекс.Карт (необязателен).
NUXT_PUBLIC_YANDEX_MAPS_API_KEY=
# Публичный ключ виджета Yandex SmartCaptcha (необязателен; без ключей капча
# не показывается, форма защищена honeypot и лимитами).
NUXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY=

# ─── Серверные интеграции (секреты) ────────────────────────────────────────
# Серверный ключ проверки Yandex SmartCaptcha.
SMARTCAPTCHA_SERVER_KEY=

# Telegram: бот уведомлений о резервах и чаты-получатели (через запятую).
TELEGRAM_BOT_TOKEN=
TELEGRAM_RESERVATION_CHAT_IDS=
# Бот заявок партнёрства.
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=

# ─── Данные и лимиты ───────────────────────────────────────────────────────
# Каталоги файловых хранилищ (аккаунты/сессии, брони, заявки). На Vercel
# переменные не задавать: ФС проекта только для чтения, сторы автоматически
# уходят в /tmp (данные эфемерны — см. README, «Деплой»); постоянство —
# VPS с томом или внешний стор.
ACCOUNT_DATA_DIR=.data/account
RESERVATION_DATA_DIR=.data/reservations
PARTNERSHIP_DATA_DIR=.data/partnership
STAFF_INBOX_PHONES=
